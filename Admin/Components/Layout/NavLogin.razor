@code {
  [Parameter]
  public bool IsOpen { get; set; }

  [Parameter]
  public EventCallback<bool> IsOpenChanged { get; set; }

  [Parameter]
  public bool Dense { get; set; }

  [Parameter]
  public Breakpoint Breakpoint { get; set; }

  [Parameter]
  public DrawerClipMode ClipMode { get; set; }

  private bool _dense => Dense;
  private Breakpoint _breakpoint => Breakpoint;
  private DrawerClipMode _clipMode => ClipMode;

  private Anchor _anchor;
  private bool _overlayAutoClose = true;


  private bool _open
  {
    get => IsOpen;
    set
    {
      if (IsOpen == value) return;
      IsOpen = value;
      IsOpenChanged.InvokeAsync(value);
    }
  }

  private void ToggleDrawer(Anchor anchor)
  {
    _open = !_open;
    _anchor = anchor;
  }

  private async Task OnLogoutClicked()
  {
    await AuthService.LogoutAsync();
    Snackbar.Add("TERIMA KASIH", Severity.Success);
    Console.WriteLine("Logout");

    Navigation.NavigateTo("/login", forceLoad: true);
  }
}