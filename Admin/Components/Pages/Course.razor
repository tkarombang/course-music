@page "/course"
@using Admin.Models
@using Admin.Services
@using Admin.Services.CourseService
@using MudBlazor
@rendermode InteractiveServer
@layout Layout.MainLayout

@inject NavigationManager Navigation
@inject IAdminAuthService AuthService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject CoursesApiService CourseService

<MudMainContent Class="m-auto h-100">
	<MudContainer Class="mt-6">
		<MudPaper Class="pa-5 mt-5 mb-2" Elevation="2" Style="background-color:white;">
			<!-- Header -->
			<MudText Typo="Typo.h5" Class="mb-2">Course Management</MudText>

			@if (_isLoading)
			{
				<MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="d-flex justify-center my-8" />
			}
			else
			{
				<!-- Add Course Button -->
				<MudButton Variant="Variant.Filled" Size="Size.Small"
					Style="text-align:center; background-color:#226957; color:white;" Class="mb-3" OnClick="@OpenDialogAdd">
					Add Course
				</MudButton>

				<!-- Search Bar -->
				<MudTextField @bind-Value="SearchTerm" Placeholder="Search by Nama Course..." Variant="Variant.Outlined"
					Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-5" Immediate="true" />

				<!-- Course Table -->
				<MudSimpleTable Hover="@hover" Style="overflow-x:auto;">
					<thead>
						<tr class="text-center">
							<th>No</th>
							<th>Nama Course</th>
							<th>Deskripsi</th>
							<th style="text-align: center">Harga</th>
							<th style="text-align: center">Image</th>
							<th style="text-align: center">Action</th>
						</tr>
					</thead>
					<tbody>
						@if (_filteredCourses.Any())
						{
							@foreach (var course in _filteredCourses.Select((c, index) => new { Course = c, Index = index + 1 }))
							{
								<tr class="text-center">
									<td>@course.Index</td>
									<td>@course.Course.NamaCourse</td>
									<td style="text-align:left; max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
										@course.Course.Deskripsi
									</td>
									<td style="text-align: center">@course.Course.Harga.ToString("C0", new
																	System.Globalization.CultureInfo("id-ID"))</td>
						<td style="text-align: center">
							@if (!string.IsNullOrEmpty(course.Course.ImageCourse))
										{
											<MudImage Src="@course.Course.ImageCourse" Alt="Course Image"
												Style="max-width:60px; max-height:60px;" />
										}
										else
										{
											<span>No Image</span>
										}
									</td>
									<td style="text-align: center">
										<MudStack Row="true" Spacing="1" Justify="Justify.Center">
											<MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
												@onclick="() => OpenDialogEdit(course.Course)">
												Edit
											</MudButton>

											<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
												@onclick="() => ConfirmDelete(course.Course.IdCourse, course.Course.NamaCourse)" />
										</MudStack>
									</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="5" class="text-center">No courses found.</td>
							</tr>
						}
					</tbody>
				</MudSimpleTable>
			}
		</MudPaper>
	</MudContainer>
</MudMainContent>

@code {
	private List<CourseModel> _courses = new();
	private List<CourseModel> _filteredCourses = new();
	private bool hover = true;
	private bool _isLoading = true;
	private string errorMessage = string.Empty;
	private string adminData = string.Empty;

	private string _searchTerm = string.Empty;
	private string SearchTerm
	{
		get => _searchTerm;
		set
		{
			_searchTerm = value;
			_filteredCourses = string.IsNullOrWhiteSpace(_searchTerm)
			? _courses
			: _courses.Where(c => c.NamaCourse.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		await FetchCoursesAsync();
	}





	private async Task FetchCoursesAsync()
	{
		try
		{
			_courses = await CourseService.GetAllCourses();
			_filteredCourses = _courses;
			Console.WriteLine($"Fetched {_courses.Count} courses.");

			foreach(var kursus in _courses.Take(2))
			{
				Console.WriteLine($"ID: {kursus.IdCourse}, NAMA KURSUS: {kursus.NamaCourse}, GAMBAR: {kursus.ImageCourse}");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ERROR FETCHING COURSES]: {ex.Message}");
			Snackbar.Add("Failed to fetch courses.", Severity.Error);
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}





	private async Task OpenDialogAdd()
	{
		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		var dialog = DialogService.Show<CourseAdd>("Add New Course", options);
		var result = await dialog.Result;

		if (!result.Canceled && result.Data is CourseCreateModel newCourse)
		{
			try
			{
				@* await ApiService.AddNewCourse(newCourse); *@
				Snackbar.Add("Course added successfully!", Severity.Success);
				await FetchCoursesAsync();
			}
			catch (Exception ex)
			{
				Console.WriteLine($"[GAGAL ADD COURSE]: {ex.Message}");
				Snackbar.Add("Failed to add course.", Severity.Error);
			}
		}
	}

	private async Task OpenDialogEdit(CourseModel course)
	{
		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			MaxWidth = MaxWidth.Medium,
			FullWidth = true
		};

		var parameters = new DialogParameters { ["ModelToEdit"] = course };

		var dialog = DialogService.Show<CourseEdit>("Edit Course", parameters, options);
		var result = await dialog.Result;

		if (!result.Canceled && result.Data is CourseCreateModel updateCourse)
		{
			try
			{
				@* await ApiService.UpdateCourse(updateCourse); *@
				Snackbar.Add("Course updated successfully!", Severity.Success);
				await FetchCoursesAsync();
			}
			catch (Exception ex)
			{
				Console.WriteLine($"[GAGAL UPDATE COURSE]: {ex.Message}");
				Snackbar.Add("Failed to update course.", Severity.Error);
			}
		}
	}

	private async Task ConfirmDelete(int courseId, string courseName)
	{
		bool? result = await DialogService.ShowMessageBox(
		"Confirm Delete",
		$"Are you sure you want to delete course '{courseName}'?",
		yesText: "Yes", cancelText: "No");

		if (result == true)
		{
			await DeleteCourseAsync(courseId);
		}
	}

	private async Task DeleteCourseAsync(int courseId)
	{
		try
		{
			await CourseService.DeleteCourse(courseId);
			Snackbar.Add("Course deleted successfully!", Severity.Success);
			await FetchCoursesAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ERROR DELETE COURSE]: {ex.Message}");
			Snackbar.Add("Failed to delete course.", Severity.Error);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			StateHasChanged();
			try
			{
				var isAuthenticated = await AuthService.IsAuthenticatedAsync();
				if (!isAuthenticated)
				{
					Navigation.NavigateTo("/login");
					return;
				}

				await CourseService.InitializeAsync();
				adminData = await CourseService.GetAdminDataAsync();
			}
			catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
			{
				errorMessage = "Unauthorized: Please log in again.";
				Navigation.NavigateTo("/login");
			}
			catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
			{
				errorMessage = "Forbidden: You don't have admin access.";
			}
			catch (Exception ex)
			{
				errorMessage = $"Failed to load admin data: {ex.Message}";
			}
			finally
			{
				_isLoading = false;
				StateHasChanged();
			}
		}
	}
}