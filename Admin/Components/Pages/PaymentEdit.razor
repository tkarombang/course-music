@using System.ComponentModel.DataAnnotations
@using Admin.Models
@using Admin.Services
@* @using Microsoft.AspNetCore.Authorization
@attribute [Authorize] *@
@layout Layout.MainLayout
@inject ISnackbar Snackbar
@inject AdminApiService ApiService

<MudDialog>
  <TitleContent>
    Edit Payment
  </TitleContent>
  <DialogContent>
    <MudPaper Class="pa-4">
      <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
        <MudTextField T="string" Label="Payment Name" @bind-Value="PayMetEdit.NameMethod" Class="mb-4" />

        <MudItem Class="d-flex">

          @if (!string.IsNullOrEmpty(PayMetEdit.CurrentLogoUrl) && PayMetEdit.LogoMethod == null)
          {
            <MudImage Src="@PayMetEdit.CurrentLogoUrl" Alt="Logo Bank" style="max-width:50px; max-height:50px;" />
          }
          else if (PayMetEdit.LogoMethod != null)
          {
            <MudText Color="Color.Info" Typo="Typo.caption">
              File baru dipilih: @PayMetEdit.LogoMethod.Name
            </MudText>
          }
          else
          {
            <MudText Color="Color.Warning" Typo="Typo.caption">No current logo.</MudText>
          }

          <InputFile OnChange="UploadLogo" />


          @* <MudFileUpload T="IBrowserFile" FilesChanged="UploadLogo" MaximumFileSize="5000000"
            Accept=".jpg, .jpeg, .png">
            <ActivatorContent>
              <MudFab Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                StartIcon="@Icons.Material.Filled.Image" Label="Logo Bank" />
              <MudText Class="ml-2" Typo="Typo.caption">
                @if (PayMetEdit.LogoMethod != null)
                {
                  <MudText Typo="Typo.caption" Color="Color.Success">File siap diunggah: @PayMetEdit.LogoMethod.Name
                  </MudText>
                }
                else
                {
                  <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Pilih File...
                  </MudText>
                }
              </MudText>
            </ActivatorContent>
          </MudFileUpload> *@
        </MudItem>



        <MudSwitch @bind-Value="IsActive" Color="Color.Tertiary">
          Status:
          @(PayMetEdit.Status)</MudSwitch>
      </MudForm>



    </MudPaper>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter]
  private IMudDialogInstance? MudDialog { get; set; }

  IList<IBrowserFile> _files = new List<IBrowserFile>();

  [Parameter]
  public PayMetModel ModelToEdit { get; set; } = new();
  private PayMetCreateModel PayMetEdit = new();
  private IBrowserFile? _selectedFile;
  private string? _imagePreview;
  private bool IsActive
  {
    get => PayMetEdit.Status == "Active";
    set => PayMetEdit.Status = value ? "Active" : "Inactive";
  }
  protected override void OnInitialized()
  {
    if (ModelToEdit != null)
    {
      PayMetEdit = new PayMetCreateModel
      {
        Id = ModelToEdit.Id,
        NameMethod = ModelToEdit.NameMethod,
        Status = ModelToEdit.Status,
        LogoFileName = ModelToEdit.LogoMethod,
      };
    }
  }

  private async Task UploadLogo(InputFileChangeEventArgs file)
  {
    _selectedFile = file.File;
    PayMetEdit.LogoMethod = _selectedFile;
    using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
    using var ms = new MemoryStream();
    await stream.CopyToAsync(ms);

    var bytes = ms.ToArray();
    _imagePreview = $"data:{_selectedFile.ContentType};base64,{Convert.ToBase64String(bytes)}";
  }


  private async Task Submit()
  {
    try
    {
      if (_selectedFile != null)
      {
        using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        PayMetEdit.LogoBase64 = Convert.ToBase64String(bytes);
        PayMetEdit.LogoFileName = _selectedFile.Name;
      }

      if (PayMetEdit.Id == null)
      {
        Snackbar.Add("PAYMENT ID TIDAK ADA.", Severity.Error);
        return;
      }

      await ApiService.UpdatePaymentMethod(PayMetEdit);
      Snackbar.Add("PAYMENT UPDATE SUKSES!", Severity.Success);
      MudDialog.Close(DialogResult.Ok(PayMetEdit));
    }
    catch (Exception err)
    {
      Snackbar.Add($"GAGAL UPDATE Payment: {err.Message}", Severity.Error);
    }
  }

  private void Cancel() => MudDialog!.Cancel();












  bool showFileError = false;
  bool success;
  string[] errors = { };
  MudTextField<string>? pwField1;
  MudForm? form;
  public string statusSwt { get; set; } = "Active";



  public class StatusSwitch : BoolConverter<string>
  {

    public StatusSwitch()
    {
      SetFunc = OnSet!;
      GetFunc = OnGet;
    }

    private string TrueString = "Active";
    private string FalseString = "Inactive";

    private string OnGet(bool? value)
    {
      try
      {
        return (value == true) ? TrueString : FalseString;
      }
      catch (Exception e)
      {
        UpdateSetError("Conversion error: " + e.Message);
        return e.Message;
      }
    }

    private bool? OnSet(string arg)
    {
      if (arg == null)
        return null;
      try
      {
        if (arg == TrueString)
          return true;
        if (arg == FalseString)
          return false;
        else
          return null;
      }
      catch (FormatException e)
      {
        UpdateSetError("Conversion error: " + e.Message);
        return null;
      }
    }

  }


}