@page "/login"
@using Admin.Models
@using Admin.Services
@layout Layout.LoginLayout
@inject IAdminAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-20">
  <MudCard class="pa-5">
    <MudCardHeader>
      <CardHeaderContent>
        <MudText Typo="Typo.h6">Login</MudText>
      </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
      <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" OnInvalidSubmit="@HandleInvalidSubmit">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="loginModel.Email" Label="Email" Variant="Variant.Outlined" Class="mb-4"
          For="@(() => loginModel.Email)" />
        <MudTextField @bind-Value="loginModel.Password" Label="Password" Variant="Variant.Outlined"
          InputType="InputType.Password" Class="mb-4" For="@(() => loginModel.Password)" />
        <MudButton Variant="Variant.Filled" style="background-color:#226957; color:white;" ButtonType="ButtonType.Submit" FullWidth="true"
          Disabled="@isLoading">
          @if (isLoading)
          {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <span>Logging in...</span>
          }
          else
          {
            <span>Login</span>
          }
        </MudButton>
      </EditForm>
      @if (!string.IsNullOrEmpty(errorMessage))
      {
        <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
      }
    </MudCardContent>
  </MudCard>
</MudContainer>

@code {
  private LoginModel loginModel = new();
  private bool isLoading = false;
  private string errorMessage = string.Empty;

  protected override void OnInitialized()
  {
    Console.WriteLine("Debug: Login.razor initialized");
  }

  private async Task HandleLogin()
  {
    if (isLoading) return;
    isLoading = true;
    errorMessage = string.Empty;

    try
    {
      var token = await AuthService.LoginAsync(loginModel);
      Navigation.NavigateTo("/home");
    }
    catch (UnauthorizedAccessException ex)
    {
      if(ex.Message.Contains("Admin access required"))
      {
        Snackbar.Add("ANDA HARUS LOGIN SEBAGAI ADMIN", Severity.Error);
      }
      else
      {
        Snackbar.Add("EMAIL ATAU PASSWORD SALAH", Severity.Error);
      }
    }
    catch
    {
      errorMessage = "TERJADI KESALAHAN, COBA LAGI.";
      Snackbar.Add(errorMessage, Severity.Error);
    }
    finally
    {
      isLoading = false;
    }
  }

  private void HandleInvalidSubmit()
  {
    Console.WriteLine("Debug: HandleInvalidSubmit called - Form validation failed");
    errorMessage = "Please fill in all required fields.";
  }
}