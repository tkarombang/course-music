@page "/login"
@using System.Net.Http.Json
@using Frontend.Components.Layout
@using Frontend.DTOs
@using Frontend.Services
@using Frontend.Interface
@using Frontend.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@layout Layout.MainLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IAuthClientService AuthService
@attribute [AllowAnonymous]


<PageTitle>Login</PageTitle>


<div class="container">
    <div class="main-upper">
        <div class="header-login">
            <h1 class="home-title">Selamat Datang Musikers!</h1>
            <p>Login dulu yuk</p>
        </div>

        <MudForm @ref="_form">

            <!-- ================= DESKTOP (md ke atas) ================= -->
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudTextField T="string" Class="custom-input" Style="width: 616px; height: 37px;
                                     border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 14px"
                    @bind-Value="loginModel.Email" Placeholder="Masukan Email" Variant="Variant.Outlined" Required="true"
                    RequiredError="Email belum terisi" For="@(() => Email)" Clearable="true"
                    Validation="@((string? value) => ValidateEmail(value))" />

                <MudTextField T="string" Class="custom-input" Style="width: 616px; height: 37px; margin-top: 24px;
                                     border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 14px"
                    @bind-Value="loginModel.Password" Placeholder="Masukan Password" Variant="Variant.Outlined"
                    InputType="InputType.Password" Required="true" RequiredError="Password belum terisi"
                    For="@(() => Password)" Clearable="true" />

                <div class="forgot" style="width:616px; text-align:right; margin-top:4px;">
                    <a href="/forgotpassword">Lupa kata sandi</a>
                </div>
            </MudHidden>

            <!-- ================= MOBILE (xs & sm) ================= -->
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudTextField T="string" Class="custom-input" Style="width: 350px; height: 37px;
                                     border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 14px"
                    @bind-Value="loginModel.Email" Placeholder="Masukan Email" Variant="Variant.Outlined" Required="true"
                    RequiredError="Email belum terisi" For="@(() => Email)" Clearable="true"
                    Validation="@((string? value) => ValidateEmail(value))" />

                <MudTextField T="string" Class="custom-input" Style="width: 350px; height: 37px; margin-top: 24px;
                                     border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 14px"
                    @bind-Value="loginModel.Password" Placeholder="Masukan Password" Variant="Variant.Outlined"
                    InputType="InputType.Password" Required="true" RequiredError="Password belum terisi"
                    For="@(() => Password)" Clearable="true" />

                <div class="forgot" style="width:350px; text-align:right; margin-top:4px;">
                    <a href="/forgotpassword">Lupa kata sandi</a>
                </div>
            </MudHidden>

        </MudForm>
    </div>

    <div class="main-low">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
            Style="width: 140px; height: 43px; border-radius: 8px; margin-top:40px;" OnClick="OnLoginClicked">
            Masuk
        </MudButton>

        <div class="register">
            Belum punya akun?
            <a href="/register">Daftar disini</a>
        </div>
    </div>
</div>



@code {
    private LoginRequestDto loginModel = new();
    private string? _tokenToSave;
    private MudForm? _form;
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private string? ValidateEmail(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Email belum terisi";

        if (!value.Contains("@") || !value.Contains("."))
            return "Email harus berisi '@' dan '.'";

        return null;
    }

    private async Task OnLoginClicked()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = string.Empty;
        await _form!.Validate();

        if (_form.IsValid)
        {
            try
            {
                var token = await AuthService.Login(loginModel);
                Navigation.NavigateTo("/landingPage");
            }
            catch (Exception err)
            {
                Snackbar.Add("Terjadi kesalahan, Coba Lagi.", Severity.Error, config =>
                {
                    config.ShowCloseIcon = false;
                    config.VisibleStateDuration = 3000;
                });
                Console.WriteLine($"ERROR: {err.Message}");
            }
            finally
            {
                isLoading = false;
            }
        }
    }
    

}