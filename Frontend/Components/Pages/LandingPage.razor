        position:absolute;
        top:0;
        left:0;
        width:100%;
        height:100%;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5));
        z-index:1;
    "></div>

  <!-- content -->
  <div style="position: relative; z-index:2; padding-top: 80px;">
    <MudContainer Class="mud-py-10" Style="margin-top:auto;">
      <!-- Heading -->
      <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-8 mt-n6 text-white" Style="font-weight:500;">
        Hi Musiker! Gabung yuk di Apel Music
      </MudText>
      <MudText Typo="Typo.h5" Align="Align.Center" class="text-white">
        Banyak kelas keren yang bisa menunjang bakat bermusik kamu
      </MudText>

      <!-- Cards -->
      <MudGrid Justify="Justify.Center" Spacing="4" Style="margin-top: 35px;">
        <!-- Card 1 -->
        <MudItem xs="12" sm="4">
          <MudCard Class="mud-elevation-6" Style="height: 250px; border-radius: 16px; ">
            <MudCardContent Class="d-flex flex-column align-center text-center" Style="height: 100%; padding: 16px;">
              <MudText Typo="Typo.h2" Class="mb-10 mt-3" Color="Color.Secondary">500+</MudText>
              <MudText Align="Align.Center" Typo="Typo.subtitle1" Class="mud-text-dark">
                Lebih dari sekedar kelas biasa yang bisa mengeluarkan bakat kalian
              </MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Card 2 -->
        <MudItem xs="12" sm="4">
          <MudCard Class="mud-elevation-6" Style="height: 250px; border-radius: 16px; ">
            <MudCardContent Class="d-flex flex-column align-center text-center" Style="height: 100%; padding: 16px;">
              <MudText Typo="Typo.h2" Class="mb-10 mt-3" Color="Color.Secondary">50+</MudText>
              <MudText Align="Align.Center" Typo="Typo.subtitle1" Class="mud-text-dark">
                Lulusan yang menjadi musisi ternama dengan skill memukau
              </MudText>
            </MudCardContent>
          </MudCard>
        </MudItem>

        <!-- Card 3 -->
        <MudItem xs="12" sm="4">
          <MudCard Class="mud-elevation-6" Style="height: 250px; border-radius: 16px; ">
            <MudCardContent Class="d-flex flex-column align-center text-center" Style="height: 100%; padding: 16px;">
              <MudText Typo="Typo.h2" Class="mb-10 mt-3" Color="Color.Secondary">10+</MudText>
              <MudText Align="Align.Center" Typo="Typo.subtitle1" Class="mud-text-dark">
