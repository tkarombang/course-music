@code {
  private bool _isLoading = true;

  private string errorMessage = string.Empty;
  void NavigateToDetail(string category, string courseName)
  {
    var encodedCourse = Uri.EscapeDataString(courseName);
    Navigation.NavigateTo($"/detailkelas/{category}/{encodedCourse}");
  }
  @* protected override async Task OnInitializedAsync()
  {
    try
    {
      var user = await ApiService.GetCurrentUserAsync();
      if (user == null)
      {
        Snackbar.Add("Gagal memuat data pengguna.", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Terjadi kesalahan: {ex.Message}");
    }
  } *@


  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        await Task.Delay(100);

        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
          Navigation.NavigateTo("/login");
          return;
        }

        await ApiService.InitializeAsync();
      }
      catch (InvalidOperationException ex)
      {
        Console.WriteLine($"[DEBUG] JSRuntime belum siap: {ex.Message}");
      }
      catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
      {
        errorMessage = "Unauthorized: Please log in again.";
        Navigation.NavigateTo("/login");
      }
      catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage = "Forbidden: You don't have admin access.";
      }
      catch (Exception ex)
      {
        errorMessage = $"Failed to load admin data: {ex.Message}";
      }
      finally
      {
        _isLoading = false;
        StateHasChanged();
      }
    }
  }

}