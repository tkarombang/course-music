@page "/forgotpassword"
@rendermode InteractiveServer
@using Frontend.Models
@using Frontend.DTOs
@using System.ComponentModel.DataAnnotations
@using Frontend.Services
@using Frontend.Interface
@inject NavigationManager NavigateToNewPass
@inject ISnackbar Snackbar
@inject IAuthClientService AuthClientService
@inject ClientApiService ApiService

<PageTitle>Forgot Password</PageTitle>

@* JANGAN LUPA HAPUS xs sm  xs=3 | xs="12" sm="7"*@
<MudGrid Class="d-flex justify-center align-center hapus-sebentar">
  @* <div class="center-content"> *@
  <MudItem Class="d-flex justify-center form-wrapper">
    <MudCard Class="pa-4 custom-size mb-10">
      <MudText Typo="Typo.h5">Reset Password</MudText>
      <MudText Typo="Typo.subtitle1" Class="mt-2">Silahkan masukkan terlebih dahulu email anda
      </MudText>

      @* <MudPaper Class="mt-10 border-solid border-2 pa-2 rounded-lg" Style="@($"color:{Colors.Gray.Lighten1};")" Elevation="0"> *@
      <MudForm Class="mt-10" Model="@model" @bind-IsValid="@isFormValid" OnValidSubmit="HandleSubmit" @ref="form">
        <MudTextField Variant="Variant.Outlined" T="string" Label="Masukkan Email" Required="true"
          @bind-Value="model.Email" For="@(() => model.Email)" Immediate="true" />

        @* </MudPaper> *@

        <MudItem Class="pa-4 mt-4 d-flex gap-10">
          <MudButton Variant="Variant.Outlined" style="width:140px;" Color="Color.Primary" DropShadow="false"
            Class="rounded-lg" Href="/login">Batal</MudButton>
          <MudButton Variant="Variant.Filled" style="width:140px;" Color="Color.Primary" DropShadow="false"
            Class="mx-2 rounded-lg" OnClick="HandleSubmit" Disabled="@(!isFormValid)">
            Konfirmasi
          </MudButton>
        </MudItem>
      </MudForm>
    </MudCard>
  </MudItem>
  @* </div> *@

</MudGrid>

<style>
  @* .center-content {
    display:flex;
    justify-content: center;
    align-items: center;
    height: 87vh;
  } *@
  .hapus-sebentar {
    height: 88vh;
  }

  .custom-size {
    width: 48vw;
  }
</style>


@code {
  private ForgotPasswordRequestDto model = new();
  private MudForm? form;
  private bool isFormValid;

  private bool _isLoading = true;

  private string errorMessage = string.Empty;

  protected override void OnInitialized()
  {
    Console.WriteLine("[BLAZOR INIT] Komponen ForgotPassword berhasil diinisialisasi.");
  }

  private async Task HandleSubmit()
  {
    if (isFormValid)
    {
      Console.WriteLine($"[BLAZOR DEBUG] Form Submit terpicu untuk {model.Email}");

      bool success = await AuthClientService.ForgotPassword(model);

      if (success)
      {
        Snackbar.Add($"LINK RESET TELAH DIKIIRIM KE {model.Email}.", Severity.Info, config =>
        {
          config.ShowCloseIcon = false;
          config.VisibleStateDuration = 1000;
        });

        model = new ForgotPasswordRequestDto();
        form?.ResetAsync();
      }
      else
      {
        Snackbar.Add($"TERJADI KESALAHAN KONEKSI SERVER. try again.", Severity.Error);
      }

    }
    else
    {
      Snackbar.Add("Formulir tidak valid. Periksa input Anda.", Severity.Warning);
    }

  }


  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        await Task.Delay(100);

        var isAuthenticated = await AuthClientService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
          NavigateToNewPass.NavigateTo("/landingpage");
          return;
        }

        await ApiService.InitializeAsync();
      }
      catch (InvalidOperationException ex)
      {
        Console.WriteLine($"[DEBUG] JSRuntime belum siap: {ex.Message}");
      }
      catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Accepted)
      {
        errorMessage = "Unauthorized: Please log in again.";
        NavigateToNewPass.NavigateTo("/landingpage");
      }
      catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
      {
        errorMessage = "Forbidden: You don't have admin access.";
      }
      catch (Exception ex)
      {
        errorMessage = $"Failed to load admin data: {ex.Message}";
      }
      finally
      {
        _isLoading = false;
        StateHasChanged();
      }
    }
  }


  private void ToNewPassPage()
  {
    @* NavigateToNewPass.NavigateTo("/newpassword"); *@
  }


}