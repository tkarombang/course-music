@page "/newpassword"
@rendermode InteractiveServer
@using Frontend.Models
@using Frontend.DTOs
@using System.ComponentModel.DataAnnotations
@using Frontend.Services
@using Frontend.Interface
@inject NavigationManager NavigateToLogin
@inject ISnackbar Snackbar
@inject IAuthClientService AuthClientService

<PageTitle>New Password</PageTitle>

<MudGrid Class="d-flex justify-center align-center hapus-sebentar">
  <MudItem Class="d-flex justify-center">
    <MudCard Class="pa-4 custom-size mb-10">
      <MudText Typo="Typo.h5">Buat Password</MudText>

      <MudForm Class="pa-2 mt-10" Model="@model" OnValidSubmit="HandleSubmit" @bind-IsValid="@isFormValid"
        @ref="form">

        <MudTextField Variant="Variant.Outlined" T="String" Label="Passowrd Baru" For="@(() => model.NewPassword)"
          Required="true" @bind-Value="model.NewPassword" InputType="@(iShow ? InputType.Text : InputType.Password)"
          Adornment="Adornment.End"
          AdornmentIcon="@(iShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
          OnAdornmentClick="(() => iShow = !iShow)" AdornmentAriaLabel="Tampilkan" Immediate="true" />

        @* <MudPaper Class="mt-5 border-solid border-2 pa-2 rounded-lg" Style="@($"color:{Colors.Gray.Lighten1};")" Elevation="0"> *@
        <MudTextField Variant="Variant.Outlined" T="String" Label="Konfirmasi Password Baru"
          For="@(() => model.ConfirmPassword)" Required="true" @bind-Value="model.ConfirmPassword"
          InputType="@(iShow ? InputType.Text : InputType.Password)" Adornment="Adornment.End"
          AdornmentIcon="@(iShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
          OnAdornmentClick="(() => iShow = !iShow)" AdornmentAriaLabel="Tampilkan" Immediate="true" />
        @* </MudPaper> *@


        <MudItem Class="pa-4 mt-4 d-flex gap-10">
          <MudButton Variant="Variant.Outlined" style="width:140px;" Color="Color.Primary" DropShadow="false"
            Class="rounded-lg" Href="/login">Batal</MudButton>
          <MudButton Variant="Variant.Filled" style="width:140px;" Color="Color.Primary" DropShadow="false"
            Class=" mx-2 rounded-lg" Disabled="@(!isFormValid)" OnClick="HandleSubmit">
            Kirim
          </MudButton>
        </MudItem>
      </MudForm>

    </MudCard>
  </MudItem>
</MudGrid>

<style>
  @* .center-content {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 80vh;
  } *@

  .hapus-sebentar {
    height: 88vh;
  }

  .custom-size {
    width: 48vw;
  }
</style>




@code {
  [SupplyParameterFromQuery]
  public string Email { get; set; } = string.Empty;

  [SupplyParameterFromQuery]
  public string Token { get; set; } = string.Empty;

  private ResetPasswordRequestDto model = new();
  // private NewPasswordModels model = new();
  private MudForm? form;
  private bool isFormValid;
  private bool iShow;
  InputType PasswordInput = InputType.Password;
  string PasswordInputDot = Icons.Material.Filled.VisibilityOff;

  protected override void OnInitialized()
  {
    model.Email = this.Email;
    model.Token = this.Token;

    if (string.IsNullOrEmpty(model.Email) || string.IsNullOrEmpty(model.Token))
    {
      Snackbar.Add("TAUTAN RESET PASSWORD TIDAK VALID/HILANG", Severity.Error);
      NavigateToLogin.NavigateTo("/login");
    }
  }


  void ButtonEyeClick()
  {
    @if (iShow)
    {
      iShow = false;
      PasswordInputDot = Icons.Material.Filled.VisibilityOff;
      PasswordInput = InputType.Password;
    }
    else
    {
      iShow = true;
      PasswordInputDot = Icons.Material.Filled.Visibility;
      PasswordInput = InputType.Text;
    }
  }


  



  private async Task HandleSubmit()
  {
    bool success = await AuthClientService.ResetPassword(model);

    if (success)
    {
      Snackbar.Add("PASSWORD BERHASIL DIUBAH! SILAHKAN LOGIN.", Severity.Success, config =>
      {
        config.ShowCloseIcon = false;
        config.VisibleStateDuration = 3000;
      });

      await Task.Delay(4000);

      NavigateToLogin.NavigateTo("/login", forceLoad: true);
    }
    else
    {
      Snackbar.Add("GAGAL RESET PASSWORD. TOKEN INVALID ATAU SUDAH KADALUARSA.", Severity.Error);
    }
  }


  private void GoToLoginPage()
  {
    NavigateToLogin.NavigateTo("/login");
  }
}