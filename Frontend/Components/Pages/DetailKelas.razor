@code {
    private bool resetValueOnEmptyText = true;
    private bool coerceText = true;
    private bool coerceValue = true;
    private bool selectedOnTab = true;
    private string? value1;
    private string[] jadwalTanggal = Array.Empty<string>();

    [Parameter] public string categoryName { get; set; } = string.Empty;
    [Parameter] public string courseName { get; set; } = string.Empty;

    private CategoryWithCoursesDto? categoryData;
    private CourseDto? selectedCourse;
    private bool _open; // untuk toggle popover
    private string? _selectedPayment;
    private List<PaymentMethodLocal>? PaymentMethods;

    private class PaymentMethodLocal
    {
        public int Id { get; set; }
        public string Name_Methode { get; set; } = string.Empty;
        public string Logo_Methode { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private void ToggleOpen() => _open = !_open;
    private void SelectPayment(string method) => _selectedPayment = method;

    private string GetPaymentClass(string name)
    {
        var extra = _selectedPayment == name ? "payment-item selected" : "payment-item";
        return extra;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPaymentMethods();
    }

    private async Task LoadPaymentMethods()
    {
        try
        {
            var data = await ApiService.GetAsync<List<PaymentMethodLocal>>("api/PaymentMethod");
            if (data != null && data.Any())
            {
                @* var data = await response.Content.ReadFromJsonAsync<List<PaymentMethodLocal>>(); *@
                PaymentMethods = data?.Where(p => p.Status.Equals("Active", StringComparison.OrdinalIgnoreCase)).ToList()
                                 ?? new List<PaymentMethodLocal>();
            }
            else
            {
                Snackbar.Add("Gagal memuat metode pembayaran.", Severity.Error);
                PaymentMethods = new List<PaymentMethodLocal>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", Severity.Error);
            PaymentMethods = new List<PaymentMethodLocal>();
        }
    }

    private async Task ConfirmPayment()
{
    if (selectedCourse == null)
    {
        Snackbar.Add("Kelas tidak ditemukan.", Severity.Error);
        return;
    }

    if (string.IsNullOrWhiteSpace(value1))
    {
        Snackbar.Add("Silakan pilih jadwal kelas terlebih dahulu.", Severity.Warning);
        return;
    }

    if (string.IsNullOrEmpty(_selectedPayment))
    {
        Snackbar.Add("Silakan pilih metode pembayaran terlebih dahulu.", Severity.Warning);
        return;
    }

    // Parse tanggal jadwal
    if (!TryParseIndonesianDate(value1!, out var jadwalDate))
    {
        Snackbar.Add("Format jadwal tidak valid.", Severity.Error);
        return;
    }

    try
    {
        int? currentUserId = await ApiService.GetCurrentUserId(); // sementara hardcode user ID

        var existingCheckout = await ApiService.GetCheckoutByUserAsync(currentUserId.Value);
        if (existingCheckout != null && existingCheckout.Any(c => c.Jadwal.Date == jadwalDate.Date))
        {
            Snackbar.Add("Jadwal sudah dipilih, silakan pilih tanggal lain.", Severity.Warning);
            return;
        }

        // 1️⃣ Simpan data ke API Checkout
        var checkoutDto = new
        {
            IdUser = currentUserId,
            IdCourse = selectedCourse.IdCourse,
            Jadwal = jadwalDate
        };

        @* var checkoutResponse = await Http.PostAsJsonAsync("api/Checkout", checkoutDto); *@
        var checkoutResponse = await ApiService.PostCheckoutAsync( checkoutDto);
        if (!checkoutResponse.IsSuccessStatusCode)
        {
            var errorText = await checkoutResponse.Content.ReadAsStringAsync();
            Snackbar.Add($"Sudah memiliki Course ini", Severity.Error);
            return;
        }

        // 2️⃣ Ambil metode pembayaran terpilih
        var selectedMethod = PaymentMethods?.FirstOrDefault(p => p.Name_Methode == _selectedPayment);
        if (selectedMethod == null)
        {
            Snackbar.Add("Metode pembayaran tidak ditemukan.", Severity.Error);
            return;
        }

        // 3️⃣ Simpan ke API Payment
        decimal totalAmount = selectedCourse?.Harga ?? 0;

        var paymentDto = new
        {
            IdUser = currentUserId,
            IdPaymentMethod = selectedMethod.Id,
            IdCourse = selectedCourse!.IdCourse,
            Jadwal = jadwalDate,
            Status = "Paid",
            Amount = totalAmount
        };

        @* var paymentResponse = await Http.PostAsJsonAsync("api/Payment", paymentDto); *@
        var paymentResponse = await ApiService.PostPaymentAsync( paymentDto);
        if (paymentResponse.IsSuccessStatusCode)
        {
            Snackbar.Add("Pembayaran berhasil disimpan!", Severity.Success);
            _open = false;

            // Opsional: arahkan ke halaman sukses
            Navigation.NavigateTo("/purchaseberhasil");
        }
        else
        {
            var errorMsg = await paymentResponse.Content.ReadAsStringAsync();
            Snackbar.Add($"Gagal menyimpan pembayaran: {errorMsg}", Severity.Error);
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Terjadi kesalahan: {ex.Message}", Severity.Error);
    }
    finally
    {
        _open = false;
    }
}


    private void GoToDetail(CourseDto course, string categoryName)
    {
        var encodedName = Uri.EscapeDataString(course.NamaCourse);
        Navigation.NavigateTo($"/detailkelas/{categoryName}/{encodedName}", forceLoad: false);
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            @* categoryData = await Http.GetFromJsonAsync<CategoryWithCoursesDto>($"api/category/{categoryName}"); *@
            categoryData = await ApiService.GetAsync<CategoryWithCoursesDto>($"api/category/{categoryName}");

            if (categoryData != null)
            {
                selectedCourse = categoryData.Courses?
                    .FirstOrDefault(c => string.Equals(c.NamaCourse, courseName, StringComparison.OrdinalIgnoreCase));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading course: {ex.Message}");
        }

        // Generate 30 hari jadwal ke depan
        if (jadwalTanggal.Length == 0)
        {
            jadwalTanggal = Enumerable.Range(0, 30)
                .Select(i => DateTime.Today.AddDays(i).ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID")))
                .ToArray();
        }

        StateHasChanged();
    }

    private async Task<IEnumerable<string>> Search1(string value, CancellationToken token)
    {
        await Task.Delay(5, token);
        if (string.IsNullOrEmpty(value))
            return jadwalTanggal;

        return jadwalTanggal.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private bool TryParseIndonesianDate(string input, out DateTime result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(input))
            return false;

        var culture = new System.Globalization.CultureInfo("id-ID");

        // format-format yang mungkin muncul
        var formats = new[]
        {
            "dddd, dd MMMM yyyy", // e.g. "Jumat, 24 Oktober 2025"
            "dd MMMM yyyy",       // e.g. "24 Oktober 2025"
            "d MMMM yyyy",        // e.g. "4 Oktober 2025"
            "yyyy-MM-dd",         // ISO-like if muncul
            "dd-MM-yyyy"
        };

        // 1) coba ParseExact dengan formats (case-insensitive)
        if (DateTime.TryParseExact(input, formats, culture,
                System.Globalization.DateTimeStyles.None, out result))
            return true;

        // 2) coba DateTime.TryParse (lebih fleksibel)
        if (DateTime.TryParse(input, culture, System.Globalization.DateTimeStyles.None, out result))
            return true;

        // 3) jika masih gagal, buang bagian sebelum koma (nama hari) lalu coba lagi
        var idx = input.IndexOf(',');
        if (idx >= 0 && idx + 1 < input.Length)
        {
            var afterComma = input.Substring(idx + 1).Trim();
            if (DateTime.TryParseExact(afterComma, formats, culture,
                    System.Globalization.DateTimeStyles.None, out result))
                return true;

            if (DateTime.TryParse(afterComma, culture, System.Globalization.DateTimeStyles.None, out result))
                return true;
        }

        return false;
    }

    private async Task AddToCart()
    {
        if (selectedCourse == null)
        {
            Snackbar.Add("Kelas tidak ditemukan!", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(value1))
        {
            Snackbar.Add("Silakan pilih jadwal kelas terlebih dahulu.", Severity.Warning);
            return;
        }

        // Coba parse tanggal menggunakan helper
        if (!TryParseIndonesianDate(value1!, out var jadwalDate))
        {
            Snackbar.Add("Format jadwal tidak valid. Gunakan format seperti 'Jumat, 24 Oktober 2025' atau '24 Oktober 2025'.", Severity.Error);
            return;
        }

        // Cek apakah sudah ada course lain di tanggal yang sama
        bool adaConflict = CartService.GetCart()
            .Any(c => c.Jadwal.Date == jadwalDate.Date);

        if (adaConflict)
        {
            Snackbar.Add("User tidak bisa memilih course di hari yang sama.", Severity.Warning);
            return; // batalkan tambah ke cart
        }


        // Jika Anda mau menyimpan ke database Checkout langsung saat klik "Masukkan Keranjang":
        try
        {
            // TODO: ganti dengan user id dari autentikasi yang sebenarnya
            int? currentUserId = await ApiService.GetCurrentUserId();

            var checkoutDto = new
            {
                IdUser = currentUserId,
                IdCourse = selectedCourse.IdCourse,
                Jadwal = jadwalDate // ini DateTime, HttpClient.PostAsJsonAsync akan serialisasi jadi ISO-8601
            };

            var response = await ApiService.PostCheckoutAsync( checkoutDto);

            if (response.IsSuccessStatusCode)
            {
                // Opsional: juga tambahkan ke CartService jika Anda masih ingin user melihat di keranjang lokal
                var item = new CartItem
                {
                    IdCourse = selectedCourse.IdCourse,
                    ClassName = selectedCourse.NamaCourse,
                    Price = selectedCourse.Harga,
                    Quantity = 1,
                    IsSelected = false,
                    ImageUrl = selectedCourse.ImageCourse,
                    Jadwal = jadwalDate
                };
                CartService.AddToCart(item);

                Snackbar.Add($"Kelas '{selectedCourse.NamaCourse}' berhasil dimasukkan ke keranjang.", Severity.Success);
                // Navigation.NavigateTo("/checkout"); // opsional
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Gagal menambahkan ke checkout: {response.StatusCode} - {errorText}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", Severity.Error);
        }
    }

    private async Task BuyNow()
    {
        await AddToCart(); // tambahkan dulu ke keranjang
        Navigation.NavigateTo("/checkout");
    }

