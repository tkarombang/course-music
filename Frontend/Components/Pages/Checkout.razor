@page "/checkout"
@layout Layout.CheckoutLayout
@rendermode InteractiveServer
@using Frontend.DTOs
@using Frontend.Services
@using Cart.Models
@using System.Globalization
@using Microsoft.AspNetCore.SignalR.Client
@inject CartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@* @inject HttpClient Http *@
@inject ClientApiService ApiService

@implements IDisposable

<PageTitle>Checkout</PageTitle>

<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudCard Class="pa-6 border-none" Outlined="true">
        <!-- Header: Pilih Semua -->
        <MudStack Row Class="mb-4">
            <MudCheckBox @bind-Value="SelectAll" Color="Color.Secondary" Label="Pilih Semua" />
        </MudStack>

        <MudDivider Style="background-color:black; height:2px; width: 100%" />

        <!-- List Item -->
        @foreach (var item in CartService.GetCart())
        {
            <MudContainer Class="pa-5 ml-n7">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <!-- Kiri -->
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudCheckBox @bind-Value="item.IsSelected" Color="Color.Secondary" />

                        <MudImage Src="@($"http://localhost:5058/img/list_kelas/{item.ImageUrl}")" Class="rounded-lg"
                            Width="200" Height="133" />

                        <MudStack Style="margin-left:16px;" AlignItems="AlignItems.Start" Spacing="1">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:bold;">
                                @item.ClassName
                            </MudText>
                            <MudText Typo="Typo.body2">
                                Jadwal: @(item.Jadwal.ToString("dddd, dd MMMM yyyy", new CultureInfo("id-ID")))
                            </MudText>
                            <MudText Color="Color.Secondary">
                                IDR @item.Price.ToString("N0")
                            </MudText>
                        </MudStack>
                    </MudStack>

                    <!-- Hapus -->
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.RestoreFromTrash" Color="Color.Error"
                            OnClick="@(() => RemoveItem(item.IdCourse))" />
                        <MudText Typo="Typo.body2">Delete</MudText>
                    </MudStack>
                </MudStack>
            </MudContainer>

            <MudDivider Class="mt-6" Style="background-color:black; height:2px; width: 100%" />
        }

        <!-- Footer Total -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.subtitle1">Total Biaya:</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    IDR @Total.ToString("N0")
                </MudText>
            </MudStack>

            <MudButton Color="Color.Secondary" Variant="Variant.Filled" Style="width:250px;" OnClick="@ToggleOpen">
                Bayar Sekarang
            </MudButton>
        </MudStack>
    </MudCard>

    @if (_open)
    {
        <div class="overlay"></div>
        <MudPopover Open="@_open" Fixed="true" Class="popup-view px-4 pt-4" Style="width:374px; height:550px;">
            <div class="d-flex flex-column">
                <MudText Class="mb-4" Typo="Typo.subtitle1" Align="Align.Center">Pilih Metode Pembayaran</MudText>

                <MudStack Spacing="0">
                    @if (PaymentMethods == null)
                    {
                        <MudText Class="ml-2 mb-2">Memuat metode pembayaran...</MudText>
                    }
                    else if (!PaymentMethods.Any())
                    {
                        <MudText Color="Color.Warning" Class="ml-2 mb-2">Tidak ada metode pembayaran tersedia.</MudText>
                    }
                    else
                    {
                        @foreach (var m in PaymentMethods)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Class="@GetPaymentClass(m.Name_Methode)"
                                Style="cursor:pointer; padding:8px; border-radius:8px;"
                                @onclick="@(() => SelectPayment(m.Name_Methode))">
                                <!-- gambar dari wwwroot/img -->
                                <MudImage Style="width:40px; height:40px; object-fit:contain;"
                                    Src="@($"http://localhost:5058{m.Logo_Methode}")" Alt="@m.Name_Methode" />
                                <MudText Typo="Typo.body1" Class="ml-2">@m.Name_Methode</MudText>
                                @if (_selectedPayment == m.Name_Methode)
                                {
                                    <MudSpacer />
                                    <MudIcon Icon="@Icons.Material.Filled.Check" />
                                }
                            </MudStack>
                        }
                    }
                </MudStack>

                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
                    <MudButton Variant="Variant.Outlined" OnClick="@ToggleOpen" Style="width: 155px; height: 48px;"
                        Color="Color.Secondary">
                        Close
                    </MudButton>
                    <MudButton Variant="Variant.Filled" OnClick="@ConfirmPayment" Style="width: 155px; height: 48px"
                        Color="Color.Secondary" Disabled="@string.IsNullOrEmpty(_selectedPayment)">
                        Bayar
                    </MudButton>
                </MudStack>
            </div>
        </MudPopover>
    }
</MudHidden>

