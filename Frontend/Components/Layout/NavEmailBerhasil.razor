<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudAppBar 
        Style="height:91.51px; min-height:91.51px; justify-content: center; " 
        Elevation=0 Fixed="false" 
        class="shade white">

        <MudGrid  class="w-100 px-4">
            <MudItem xs="12" sm="6" md="3">
                <MudImage
                    style="margin-left: 40px; max-height:60px;"
                    Class="image-logo"
                    Src="img/Logo.svg" 
                    Alt="Music" 
                    Elevation="0" 
                    />
            </MudItem>
        </MudGrid>
    </MudAppBar>
</MudHidden>

