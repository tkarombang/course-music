yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# Environment & config
*.env
*.env.*
appsettings.*.json
!appsettings.json   # keep base appsettings.json under version control

# Publish outputs
publish/
out/
artifacts/

